{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "index-audit.html", "use": "@vercel/static" },
    { "src": "july-challenge-entry.js", "use": "@vercel/static" },
    { "src": "document-intake-entry-v14.js", "use": "@vercel/static" },
    { "src": "document-intake-runtime.js", "use": "@vercel/static" },
    { "src": "saisie-simple-bootstrap.js", "use": "@vercel/static" },
    { "src": "share-target-bootstrap.js", "use": "@vercel/static" },
    { "src": "pay-correction-bootstrap.js", "use": "@vercel/static" },
    { "src": "pay-detail-bootstrap.js", "use": "@vercel/static" },
    { "src": "home-pay-bootstrap.js", "use": "@vercel/static" },
    { "src": "dco-audit-bootstrap.js", "use": "@vercel/static" },
    { "src": "manifest.webmanifest", "use": "@vercel/static" },
    { "src": "tbr-icon.svg", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "ai.js", "use": "@vercel/node" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/ai", "dest": "/ai.js" },
    { "src": "/", "dest": "/index-audit.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
