{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "tbr-dco-claim-mail.js", "use": "@vercel/static" },
    { "src": "tbr-ai-ui-v2.js", "use": "@vercel/static" },
    { "src": "ai.js", "use": "@vercel/node" },
    { "src": "sentry.js", "use": "@vercel/node" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/ai", "dest": "/ai.js" },
    { "src": "/api/sentry", "dest": "/sentry.js" },
    { "src": "/tbr-dco-claim-mail.js", "dest": "/tbr-dco-claim-mail.js" },
    { "src": "/tbr-ai-ui-v2.js", "dest": "/tbr-ai-ui-v2.js" },
    { "src": "/app-shell", "dest": "/index.html" },
    { "src": "/index.html", "dest": "/index.html" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/TBR-2.0", "dest": "/index.html" },
    { "src": "/TBR-2.0/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
